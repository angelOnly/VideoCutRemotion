          "fps": 30
        }
      },
      {
        "id": "scene_010",
        "content": "那这2亿收入里，有没有真正在涨的业务？",
        "dur": 4.566667,
        "durationSource": "measured",
        "url": "http://10.20.130.251:8080/media/49362baa-6e06-441e-8b6f-6a262e795a53/45888b04-449b-47bb-9e6f-70d07d443ec2/10.mp4",
        "extraData": {
          "kind": "scene",
